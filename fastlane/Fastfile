require "digest"
require "fileutils"
require "shellwords"
require "xcodeproj"
require "base64"
require "json"
require "tempfile"
require_relative "../tool/appcast"

ENV["FASTLANE_OPT_OUT_USAGE"] = "1"
ENV["FASTLANE_SKIP_UPDATE_CHECK"] = "1"

default_platform(:mac)

REPO_ROOT = File.expand_path("..", __dir__)
PROJECT = File.join(REPO_ROOT, "VideoTagManager.xcodeproj")
SCHEME = "VideoTagManager"
PRODUCT_NAME = "Tagivy"
DISPLAY_NAME = "Tagivy"

def shell_escape(value)
  Shellwords.escape(value.to_s)
end

def release_build_settings
  @release_build_settings ||= begin
    output = sh(
      "xcodebuild -project #{shell_escape(PROJECT)} -scheme #{shell_escape(SCHEME)} " \
      "-configuration Release -showBuildSettings",
      log: false
    )
    keys = %w[MARKETING_VERSION CURRENT_PROJECT_VERSION DEVELOPMENT_TEAM PRODUCT_BUNDLE_IDENTIFIER MACOSX_DEPLOYMENT_TARGET]
    settings = {}
    output.each_line do |line|
      match = line.match(/^\s*(#{keys.join('|')})\s*=\s*(.*?)\s*$/)
      settings[match[1]] = match[2] if match
    end
    missing = keys.reject { |key| settings[key] && !settings[key].empty? }
    UI.user_error!("Release 构建设置缺少：#{missing.join(', ')}") unless missing.empty?
    settings
  end
end

def release_commit
  @release_commit ||= sh("git -C #{shell_escape(REPO_ROOT)} rev-parse HEAD", log: false).strip
end

def require_clean_release_source!
  status = sh(
    "git -C #{shell_escape(REPO_ROOT)} status --porcelain --untracked-files=all",
    log: false
  ).strip
  UI.user_error!("正式发布要求工作区无未提交改动") unless status.empty?
end

def require_github_commit!(repository)
  sh(
    "gh api #{shell_escape("repos/#{repository}/commits/#{release_commit}")} --silent"
  )
end

def release_identifier
  settings = release_build_settings
  "#{settings['MARKETING_VERSION']}-#{settings['CURRENT_PROJECT_VERSION']}"
end

def prepare_release_versions!(marketing_version)
  project = Xcodeproj::Project.open(PROJECT)
  target = project.targets.find { |candidate| candidate.name == SCHEME }
  UI.user_error!("找不到 App Target：#{SCHEME}") unless target

  current_build = target.build_configurations.filter_map do |configuration|
    Integer(configuration.build_settings["CURRENT_PROJECT_VERSION"], exception: false)
  end.max || 0
  next_build = current_build + 1

  target.build_configurations.each do |configuration|
    configuration.build_settings["CURRENT_PROJECT_VERSION"] = next_build.to_s
    configuration.build_settings["MARKETING_VERSION"] = marketing_version
  end
  project.save

  generator_path = File.join(REPO_ROOT, "tool", "generate_xcode_project.rb")
  generator = File.read(generator_path)
  build_updated = generator.sub!(/settings\["CURRENT_PROJECT_VERSION"\] = "\d+"/, "settings[\"CURRENT_PROJECT_VERSION\"] = \"#{next_build}\"")
  version_updated = generator.sub!(/settings\["MARKETING_VERSION"\] = "[^"]+"/, "settings[\"MARKETING_VERSION\"] = \"#{marketing_version}\"")
  UI.user_error!("工程生成脚本中缺少版本配置") unless build_updated && version_updated
  File.write(generator_path, generator)

  next_build
end

# Beta number from a lane option such as `beta:1`; nil for a regular release.
def beta_number(options)
  value = options[:beta].to_s.strip
  return nil if value.empty?
  UI.user_error!("beta 必须是正整数，例如：beta:1") unless value.match?(/\A[1-9]\d*\z/)
  value.to_i
end

# Version label used in tags and file names, e.g. 1.0.18 or 1.0.18-beta.1.
def release_label(beta)
  version = release_build_settings["MARKETING_VERSION"]
  beta ? "#{version}-beta.#{beta}" : version
end

def github_output_channel(beta)
  beta ? "github-beta.#{beta}" : "github"
end

def release_root(channel)
  File.join(REPO_ROOT, ".build", "releases", release_identifier, channel)
end

def validate_app!(app_path, allow_development_signing:)
  UI.user_error!("找不到 App：#{app_path}") unless File.directory?(app_path)

  info_plist = File.join(app_path, "Contents", "Info.plist")
  executable = File.join(app_path, "Contents", "MacOS", PRODUCT_NAME)
  settings = release_build_settings
  actual_version = sh("/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' #{shell_escape(info_plist)}", log: false).strip
  actual_build = sh("/usr/libexec/PlistBuddy -c 'Print :CFBundleVersion' #{shell_escape(info_plist)}", log: false).strip
  actual_bundle_id = sh("/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' #{shell_escape(info_plist)}", log: false).strip
  UI.user_error!("App 版本号不匹配：#{actual_version}") unless actual_version == settings["MARKETING_VERSION"]
  UI.user_error!("App 构建号不匹配：#{actual_build}") unless actual_build == settings["CURRENT_PROJECT_VERSION"]
  UI.user_error!("App Bundle ID 不匹配：#{actual_bundle_id}") unless actual_bundle_id == settings["PRODUCT_BUNDLE_IDENTIFIER"]

  architectures = sh("lipo -archs #{shell_escape(executable)}", log: false).split
  missing_architectures = %w[arm64 x86_64] - architectures
  UI.user_error!("App 缺少架构：#{missing_architectures.join(', ')}") unless missing_architectures.empty?

  sh("codesign --verify --deep --strict --verbose=2 #{shell_escape(app_path)}")
  unless allow_development_signing
    sparkle_code_paths(app_path).each do |path|
      details = sh("codesign -dvvv #{shell_escape(path)} 2>&1", log: false)
      UI.user_error!("Sparkle 组件 Team 不匹配：#{File.basename(path)}") unless details.include?("TeamIdentifier=#{settings['DEVELOPMENT_TEAM']}")
      UI.user_error!("Sparkle 组件未启用 Hardened Runtime：#{File.basename(path)}") unless details.match?(/flags=0x10000\(runtime\)/)
    end
  end
  signing = sh("codesign -dvvv --entitlements - #{shell_escape(app_path)} 2>&1", log: false)
  UI.user_error!("App Team 标识不匹配") unless signing.include?("TeamIdentifier=#{settings['DEVELOPMENT_TEAM']}")
  UI.user_error!("App 未启用 Hardened Runtime") unless signing.include?("flags=0x10000(runtime)")
  UI.user_error!("App 未启用 Sandbox") unless signing.include?("com.apple.security.app-sandbox")

  has_get_task_allow = signing.match?(/com\.apple\.security\.get-task-allow[\s\S]{0,120}(true|<true\/>)/)
  if allow_development_signing
    UI.important("本地包使用开发签名，仅供已配置证书的开发 Mac 使用") if has_get_task_allow
  else
    UI.user_error!("分发包包含 get-task-allow，禁止发布") if has_get_task_allow
  end
end

def release_notes_file!(output_directory)
  version = release_build_settings["MARKETING_VERSION"]
  changelog_path = File.join(REPO_ROOT, "CHANGELOG.md")
  lines = File.readlines(changelog_path)
  heading = /^## \[#{Regexp.escape(version)}\](?:\s+-.*)?\s*$/
  start_index = lines.index { |line| line.match?(heading) }
  UI.user_error!("CHANGELOG.md 缺少版本 #{version} 的发布说明") unless start_index
  end_index = lines.each_index.find { |index| index > start_index && lines[index].match?(/^## \[/) } || lines.length
  notes = lines[start_index...end_index].join.strip
  UI.user_error!("版本 #{version} 的发布说明为空") if notes.empty?

  FileUtils.mkdir_p(output_directory)
  path = File.join(output_directory, "release-notes-#{version}.md")
  File.write(path, "#{notes}\n")
  path
end

def package_base_name(beta)
  "Tagivy-#{release_label(beta)}-#{release_build_settings['CURRENT_PROJECT_VERSION']}-macOS-universal"
end

def package_app!(app_path, output_directory, beta: nil)
  FileUtils.mkdir_p(output_directory)
  base_name = package_base_name(beta)
  zip_path = File.join(output_directory, "#{base_name}.zip")
  checksum_path = "#{zip_path}.sha256"
  FileUtils.rm_f([zip_path, checksum_path])
  sh("ditto -c -k --sequesterRsrc --keepParent #{shell_escape(app_path)} #{shell_escape(zip_path)}")
  checksum = Digest::SHA256.file(zip_path).hexdigest
  File.write(checksum_path, "#{checksum}  #{File.basename(zip_path)}\n")
  UI.success("Release 包：#{File.expand_path(zip_path)}")
  UI.success("SHA-256：#{checksum}")
  [zip_path, checksum_path]
end

DEFAULT_NOTARY_PROFILE = "FileFacet-Notary"
DEFAULT_GITHUB_REPOSITORY = "larryisthere/Tagivy"
UPLOAD_ATTEMPTS = 4
# The app reads https://raw.githubusercontent.com/<repo>/<APPCAST_BRANCH>/<APPCAST_PATH> (SUFeedURL).
APPCAST_BRANCH = "appcast"
APPCAST_PATH = "appcast.xml"
GITHUB_DERIVED_DATA = File.join(REPO_ROOT, ".build", "fastlane", "github")

# Developer ID identity for the configured Team, unless DEVELOPER_ID_APPLICATION overrides it.
def developer_id_identity
  override = ENV["DEVELOPER_ID_APPLICATION"].to_s.strip
  return override unless override.empty?

  team = release_build_settings["DEVELOPMENT_TEAM"]
  identities = sh("security find-identity -p codesigning -v", log: false)
  matches = identities.scan(/"(Developer ID Application: [^"]*\(#{Regexp.escape(team)}\))"/).flatten.uniq
  UI.user_error!("找不到 Team #{team} 的 Developer ID Application 证书") if matches.empty?
  UI.user_error!("找到多个 Developer ID 证书，请用 DEVELOPER_ID_APPLICATION 指定：#{matches.join(', ')}") if matches.length > 1
  matches.first
end

def notary_profile
  value = ENV["NOTARYTOOL_KEYCHAIN_PROFILE"].to_s.strip
  value.empty? ? DEFAULT_NOTARY_PROFILE : value
end

def github_repository
  value = ENV["GITHUB_REPOSITORY"].to_s.strip
  value.empty? ? DEFAULT_GITHUB_REPOSITORY : value
end

def run_tests!
  sh("ruby", File.join(REPO_ROOT, "script", "check_invariants.rb"))
  derived_data = File.join(REPO_ROOT, ".build", "fastlane", "test")
  sh(
    "xcodebuild -project #{shell_escape(PROJECT)} -scheme #{shell_escape(SCHEME)} " \
    "-configuration Debug -derivedDataPath #{shell_escape(derived_data)} test"
  )
end

def with_retries(description)
  attempt = 1
  begin
    yield
  rescue FastlaneCore::Interface::FastlaneShellError => error
    raise error if attempt >= UPLOAD_ATTEMPTS
    delay = 5 * (2**(attempt - 1))
    UI.important("#{description}失败（第 #{attempt} 次），#{delay} 秒后重试")
    sleep(delay)
    attempt += 1
    retry
  end
end

def github_release_state(repository, tag)
  output = sh(
    "gh release view #{shell_escape(tag)} --repo #{shell_escape(repository)} --json isDraft -q .isDraft 2>/dev/null || true",
    log: false
  ).strip
  return :missing if output.empty?

  output == "true" ? :draft : :published
end

# Creates a draft release, uploads assets with retries, then publishes. Safe to rerun after a failed upload.
# Betas are published as GitHub pre-releases so they never become the latest release.
def publish_github_release!(output_directory, beta: nil)
  repository = github_repository
  version = release_build_settings["MARKETING_VERSION"]
  tag = ENV.fetch("RELEASE_TAG", "v#{release_label(beta)}")
  title = beta ? "Tagivy #{version} Beta #{beta}" : "Tagivy #{version}"
  base_name = package_base_name(beta)
  zip_path = File.join(output_directory, "#{base_name}.zip")
  checksum_path = "#{zip_path}.sha256"
  [zip_path, checksum_path].each do |path|
    UI.user_error!("找不到发布产物：#{path}，请先运行 github_release") unless File.file?(path)
  end
  expected = File.read(checksum_path).split.first
  UI.user_error!("发布包 SHA-256 与校验文件不一致") unless Digest::SHA256.file(zip_path).hexdigest == expected
  notes_path = release_notes_file!(output_directory)

  case github_release_state(repository, tag)
  when :published
    UI.user_error!("#{tag} 已经正式发布，如需覆盖请先在 GitHub 上处理")
  when :missing
    sh(
      "gh release create #{shell_escape(tag)} --draft #{beta ? '--prerelease ' : ''}" \
      "--repo #{shell_escape(repository)} " \
      "--target #{shell_escape(release_commit)} " \
      "--title #{shell_escape(title)} " \
      "--notes-file #{shell_escape(notes_path)}"
    )
  else
    UI.important("复用已有的 #{tag} 草稿")
  end

  [zip_path, checksum_path].each do |path|
    with_retries("上传 #{File.basename(path)}") do
      sh(
        "gh release upload #{shell_escape(tag)} #{shell_escape(path)} --clobber " \
        "--repo #{shell_escape(repository)}"
      )
    end
  end
  sh("gh release edit #{shell_escape(tag)} --draft=false --repo #{shell_escape(repository)}")
  UI.success("已发布 #{tag}")
  publish_appcast!(zip_path, tag, title, beta)
end

# Sparkle's helpers, innermost first, as they need re-signing with the app's Developer ID.
def sparkle_code_paths(app_path)
  framework = File.join(app_path, "Contents", "Frameworks", "Sparkle.framework")
  UI.user_error!("App 中缺少 Sparkle.framework") unless File.directory?(framework)
  version = File.join(framework, "Versions", "B")
  [
    *Dir.glob(File.join(version, "XPCServices", "*.xpc")).sort,
    File.join(version, "Autoupdate"),
    File.join(version, "Updater.app"),
    framework
  ].select { |path| File.exist?(path) }
end

def resign_sparkle!(app_path, identity)
  sparkle_code_paths(app_path).each do |path|
    sh(
      "codesign --force --timestamp --options runtime --preserve-metadata=entitlements " \
      "--sign #{shell_escape(identity)} #{shell_escape(path)}"
    )
  end
  sh(
    "codesign --force --timestamp --options runtime --preserve-metadata=entitlements,requirements,flags " \
    "--sign #{shell_escape(identity)} #{shell_escape(app_path)}"
  )
end

def sparkle_tool(name)
  path = Dir.glob(File.join(GITHUB_DERIVED_DATA, "SourcePackages", "artifacts", "**", "Sparkle", "bin", name)).first
  UI.user_error!("找不到 Sparkle 工具 #{name}，请先运行 github_release 构建") unless path
  path
end

# EdDSA signature attributes from the private key in the login keychain (created once with Sparkle's generate_keys).
def sparkle_signature(zip_path)
  output = sh("#{shell_escape(sparkle_tool('sign_update'))} #{shell_escape(zip_path)}", log: false)
  signature = output[/sparkle:edSignature="([^"]+)"/, 1]
  length = output[/length="(\d+)"/, 1]
  UI.user_error!("sign_update 没有返回签名") unless signature && length
  [signature, Integer(length)]
end

def appcast_content(repository)
  output = sh(
    "gh api #{shell_escape("repos/#{repository}/contents/#{APPCAST_PATH}?ref=#{APPCAST_BRANCH}")} 2>/dev/null || true",
    log: false
  ).strip
  return [nil, nil] if output.empty?

  payload = JSON.parse(output)
  return [nil, nil] unless payload["content"]

  [Base64.decode64(payload["content"]).force_encoding("UTF-8"), payload["sha"]]
end

def gh_api_json!(path, method, body)
  Tempfile.create(["gh-api", ".json"]) do |file|
    file.write(JSON.generate(body))
    file.flush
    output = sh("gh api --method #{method} #{shell_escape(path)} --input #{shell_escape(file.path)}", log: false)
    JSON.parse(output)
  end
end

def write_appcast!(repository, xml, sha, message)
  if sha
    gh_api_json!(
      "repos/#{repository}/contents/#{APPCAST_PATH}",
      "PUT",
      { message: message, content: Base64.strict_encode64(xml), sha: sha, branch: APPCAST_BRANCH }
    )
    return
  end

  blob = gh_api_json!("repos/#{repository}/git/blobs", "POST", { content: xml, encoding: "utf-8" })
  tree = gh_api_json!("repos/#{repository}/git/trees", "POST", {
    tree: [{ path: APPCAST_PATH, mode: "100644", type: "blob", sha: blob["sha"] }]
  })
  commit = gh_api_json!("repos/#{repository}/git/commits", "POST", { message: message, tree: tree["sha"], parents: [] })
  gh_api_json!("repos/#{repository}/git/refs", "POST", { ref: "refs/heads/#{APPCAST_BRANCH}", sha: commit["sha"] })
end

# Runs after the GitHub release is public, so the enclosure URL already resolves when apps see it.
def publish_appcast!(zip_path, tag, title, beta)
  repository = github_repository
  settings = release_build_settings
  signature, length = sparkle_signature(zip_path)
  item = Appcast::Item.new(
    title: title,
    build: Integer(settings["CURRENT_PROJECT_VERSION"]),
    display_version: beta ? "#{settings['MARKETING_VERSION']} Beta #{beta}" : settings["MARKETING_VERSION"],
    beta: !beta.nil?,
    minimum_system_version: settings["MACOSX_DEPLOYMENT_TARGET"],
    download_url: "https://github.com/#{repository}/releases/download/#{tag}/#{File.basename(zip_path)}",
    length: length,
    ed_signature: signature,
    release_notes_url: "https://github.com/#{repository}/releases/tag/#{tag}",
    published_at: Time.now
  )
  with_retries("更新 appcast") do
    existing, sha = appcast_content(repository)
    xml = Appcast.with_item(existing, item, title: DISPLAY_NAME)
    write_appcast!(repository, xml, sha, "Add #{title} to appcast")
  end
  UI.success("appcast 已加入 #{title}")
end

def require_environment!(*names)
  missing = names.select { |name| ENV[name].to_s.empty? }
  UI.user_error!("缺少环境变量：#{missing.join(', ')}") unless missing.empty?
end

platform :mac do
  desc "准备正式版本并将 Build 号递增一次"
  lane :prepare_release do |options|
    require_clean_release_source!
    version = options[:version].to_s.strip
    UI.user_error!("请提供版本号，例如：version:1.0.2") if version.empty?

    next_build = prepare_release_versions!(version)
    UI.success("已准备 Tagivy #{version} (#{next_build})")
    UI.important("请更新 CHANGELOG、完成验收并提交版本改动后，再执行正式发布 lane")
  end

  desc "构建供当前开发 Mac 本地使用的签名 Universal Release"
  lane :local_release do
    output_directory = release_root("local")
    derived_data = File.join(REPO_ROOT, ".build", "fastlane", "local")
    built_app = File.join(derived_data, "Build", "Products", "Release", "#{PRODUCT_NAME}.app")
    output_app = File.join(output_directory, "#{DISPLAY_NAME}.app")

    FileUtils.rm_rf(output_directory)
    FileUtils.mkdir_p(output_directory)
    sh(
      "xcodebuild -project #{shell_escape(PROJECT)} -scheme #{shell_escape(SCHEME)} " \
      "-configuration Release -destination generic/platform=macOS " \
      "-derivedDataPath #{shell_escape(derived_data)} -allowProvisioningUpdates clean build"
    )
    FileUtils.rm_rf(output_app)
    sh("ditto #{shell_escape(built_app)} #{shell_escape(output_app)}")
    validate_app!(output_app, allow_development_signing: true)
    package_app!(output_app, output_directory)
  end

  desc "运行全部测试"
  lane :test do
    run_tests!
  end

  desc "测试通过后，使用 Developer ID 签名、公证并发布到 GitHub Releases；beta:N 发布为 Beta 预发布版"
  lane :github_release do |options|
    beta = beta_number(options)
    require_clean_release_source!
    require_github_commit!(github_repository)
    release_notes_file!(release_root("github-notes-check"))
    FileUtils.rm_rf(release_root("github-notes-check"))
    run_tests!
    output_directory = release_root(github_output_channel(beta))
    derived_data = GITHUB_DERIVED_DATA
    built_app = File.join(derived_data, "Build", "Products", "Release", "#{PRODUCT_NAME}.app")
    output_app = File.join(output_directory, "#{DISPLAY_NAME}.app")
    identity = developer_id_identity

    FileUtils.rm_rf(output_directory)
    FileUtils.mkdir_p(output_directory)
    sh("security find-identity -p codesigning -v | grep -F #{shell_escape(identity)}")
    sh(
      "xcodebuild -project #{shell_escape(PROJECT)} -scheme #{shell_escape(SCHEME)} " \
      "-configuration Release -destination generic/platform=macOS " \
      "-derivedDataPath #{shell_escape(derived_data)} -allowProvisioningUpdates clean build " \
      "CODE_SIGN_STYLE=Manual CODE_SIGN_IDENTITY=#{shell_escape(identity)} " \
      "DEVELOPMENT_TEAM=#{shell_escape(release_build_settings['DEVELOPMENT_TEAM'])} " \
      "CODE_SIGN_INJECT_BASE_ENTITLEMENTS=NO OTHER_CODE_SIGN_FLAGS=--timestamp"
    )
    sh("ditto #{shell_escape(built_app)} #{shell_escape(output_app)}")
    resign_sparkle!(output_app, identity)
    validate_app!(output_app, allow_development_signing: false)

    submission_zip = File.join(output_directory, "notarization-submission.zip")
    sh("ditto -c -k --sequesterRsrc --keepParent #{shell_escape(output_app)} #{shell_escape(submission_zip)}")
    sh(
      "xcrun notarytool submit #{shell_escape(submission_zip)} --wait " \
      "--keychain-profile #{shell_escape(notary_profile)}"
    )
    sh("xcrun stapler staple #{shell_escape(output_app)}")
    sh("xcrun stapler validate #{shell_escape(output_app)}")
    FileUtils.rm_f(submission_zip)
    package_app!(output_app, output_directory, beta: beta)
    publish_github_release!(output_directory, beta: beta)
  end

  desc "上传失败后重试：复用已公证的产物，重新上传并发布到 GitHub Releases"
  lane :github_publish do |options|
    beta = beta_number(options)
    require_clean_release_source!
    require_github_commit!(github_repository)
    publish_github_release!(release_root(github_output_channel(beta)), beta: beta)
  end

  desc "GitHub Release 已发布但 appcast 更新失败时重试：把已发布的包加入 appcast；beta:N 加入 Beta 频道"
  lane :appcast_publish do |options|
    beta = beta_number(options)
    version = release_build_settings["MARKETING_VERSION"]
    tag = ENV.fetch("RELEASE_TAG", "v#{release_label(beta)}")
    title = beta ? "Tagivy #{version} Beta #{beta}" : "Tagivy #{version}"
    zip_path = File.join(release_root(github_output_channel(beta)), "#{package_base_name(beta)}.zip")
    UI.user_error!("找不到发布产物：#{zip_path}") unless File.file?(zip_path)
    UI.user_error!("#{tag} 尚未正式发布") unless github_release_state(github_repository, tag) == :published
    publish_appcast!(zip_path, tag, title, beta)
  end

  desc "构建并上传 Mac App Store Connect 包"
  lane :app_store_release do
    require_environment!("APP_STORE_CONNECT_KEY_ID", "APP_STORE_CONNECT_ISSUER_ID", "APP_STORE_CONNECT_KEY_PATH")
    require_clean_release_source!
    output_directory = release_root("app-store")
    FileUtils.rm_rf(output_directory)
    FileUtils.mkdir_p(output_directory)

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_filepath: ENV.fetch("APP_STORE_CONNECT_KEY_PATH")
    )
    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      clean: true,
      export_method: "app-store",
      output_directory: output_directory,
      output_name: "Tagivy.pkg",
      export_options: {
        signingStyle: "automatic",
        teamID: release_build_settings["DEVELOPMENT_TEAM"]
      },
      xcargs: "-allowProvisioningUpdates"
    )
    pkg_path = File.join(output_directory, "Tagivy.pkg")
    UI.user_error!("找不到 App Store 包：#{pkg_path}") unless File.file?(pkg_path)
    upload_to_app_store(
      api_key: api_key,
      pkg: pkg_path,
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: false,
      run_precheck_before_submit: false
    )
  end
end
